<!DOCTYPE html>
<html lang="fa">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>بازی اعداد اول</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            text-align: center;
            background-color: #f4f4f4;
            color: black;
        }
        .number {
            font-size: 24px;
            margin: 10px;
            padding: 15px;
            display: inline-block;
            cursor: pointer;
            border-radius: 10px;
            background-color: white;
            border: 2px solid #007BFF;
            color: black;
            transition: all 0.3s ease-in-out;
        }
        .number:hover {
            background-color: #007BFF;
            color: white;
        }
        #score {
            font-size: 22px;
            margin: 20px;
            font-weight: bold;
            color: black;
        }
        #game {
            margin-top: 20px;
        }
    </style>
</head>
<body>
    <h1>🎮 بازی تشخیص اعداد اول 🎮</h1>
    <p>روی اعداد اول کلیک کن و امتیاز بگیر!</p>
    <div id="game"></div>
    <p id="score">امتیاز: <span id="points">0</span></p>

    <script>
        function isPrime(num) {
            if (num < 2) return false;
            for (let i = 2; i <= Math.sqrt(num); i++) {
                if (num % i === 0) return false;
            }
            return true;
        }

        function generateNumbers() {
            const gameDiv = document.getElementById("game");
            gameDiv.innerHTML = "";
            for (let i = 0; i < 6; i++) {
                let number = Math.floor(Math.random() * 50) + 1;
                let div = document.createElement("div");
                div.className = "number";
                div.textContent = number;
                div.onclick = function () {
                    if (isPrime(number)) {
                        score += 10;
                        alert("✅ درست! " + number + " یک عدد اول است.");
                    } else {
                        score -= 5;
                        alert("❌ اشتباه! " + number + " عدد اول نیست.");
                    }
                    document.getElementById("points").textContent = score;
                    generateNumbers();
                };
                gameDiv.appendChild(div);
            }
        }

        let score = 0;
        generateNumbers();
    </script>
</body>
</html>
